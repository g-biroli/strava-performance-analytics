# --- Strava API ---
# Obtenha em: https://www.strava.com/settings/api
STRAVA_ACCESS_TOKEN=999999999999999999999999999999999
STRAVA_CLIENT_ID=9999
STRAVA_CLIENT_SECRET=999999999999999999999999999999999
STRAVA_REFRESH_TOKEN=999999999999999999999999999999999

# --- E-mail para envio do relatório quinzenal ---
EMAIL_DESTINATARIO=email@gmail.com
EMAIL_REMETENTE=email@gmail.com
EMAIL_SENHA_APP=123456
